DJANGO_SECRET_KEY=change-me-before-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
ROUTING_BASE_URL=https://router.project-osrm.org
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=spotter-route-assessment/1.0 (replace-with-your-email)
ROUTE_CACHE_SECONDS=1800

# MapLibre-compatible vector style; no key required for OpenFreeMap.
BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
