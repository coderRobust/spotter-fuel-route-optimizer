{
  "info": {
    "name": "FuelRoute Optimizer",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health/"
      }
    },
    {
      "name": "Station stats",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/stations/stats/"
      }
    },
    {
      "name": "Optimize Chicago to Los Angeles",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Los Angeles, CA\",\n  \"verify_road_access\": true,\n  \"vehicle\": {\n    \"max_range_miles\": 500,\n    \"mpg\": 10,\n    \"starting_fuel_gallons\": 50\n  }\n}"
        },
        "url": "{{baseUrl}}/api/v1/routes/optimize/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test(\"Multiple real fuel purchases\", () => pm.expect(body.fuel_plan.stops.length).to.be.at.least(2));",
              "  pm.test(\"Verified coordinates only\", () => pm.expect(body.metadata.approximate_stations_allowed).to.eql(false));",
              "  pm.test(\"Station access verified\", () => pm.expect(body.metadata.road_access_verified).to.eql(true));",
              "  pm.test(\"All selected stops are road-accessible\", () => pm.expect(body.fuel_plan.stops.every(stop => stop.road_access_verified)).to.eql(true));",
              "  pm.test(\"All routed legs are within range\", () => pm.expect(body.route.leg_distances_miles.every(miles => miles <= 500)).to.eql(true));",
              "  pm.test(\"At most two routing requests\", () => pm.expect(body.metadata.routing_requests).to.be.at.most(2));",
              "  pm.test(\"Fuel balance\", () => pm.expect(Math.abs(50 + body.fuel_plan.total_gallons_purchased - body.fuel_plan.total_gallons_consumed - body.fuel_plan.final_fuel_gallons)).to.be.below(0.005));",
              "  pm.collectionVariables.set(\"mapPath\", body.map_url);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Open computed map (run the long route first)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}{{mapPath}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Map HTML returned\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid input (expect HTTP 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": "{{baseUrl}}/api/v1/routes/optimize/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "One purchase \u2014 Chicago to Oklahoma City",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Oklahoma City, OK\",\n  \"vehicle\": {\n    \"max_range_miles\": 500,\n    \"mpg\": 10,\n    \"starting_fuel_gallons\": 50\n  }\n}"
        },
        "url": "{{baseUrl}}/api/v1/routes/optimize/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test(\"Expected fuel purchases\", () => pm.expect(body.fuel_plan.stops.length).to.be.at.least(1));",
              "  pm.test(\"Verified coordinates only\", () => pm.expect(body.metadata.approximate_stations_allowed).to.eql(false));",
              "  pm.test(\"Fuel balance\", () => pm.expect(Math.abs(50 + body.fuel_plan.total_gallons_purchased - body.fuel_plan.total_gallons_consumed - body.fuel_plan.final_fuel_gallons)).to.be.below(0.005));",
              "  pm.collectionVariables.set(\"mapPath\", body.map_url);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Two purchases \u2014 Chicago to Denver",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Denver, CO\",\n  \"vehicle\": {\n    \"max_range_miles\": 500,\n    \"mpg\": 10,\n    \"starting_fuel_gallons\": 50\n  }\n}"
        },
        "url": "{{baseUrl}}/api/v1/routes/optimize/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test(\"Expected fuel purchases\", () => pm.expect(body.fuel_plan.stops.length).to.be.at.least(2));",
              "  pm.test(\"Verified coordinates only\", () => pm.expect(body.metadata.approximate_stations_allowed).to.eql(false));",
              "  pm.test(\"Fuel balance\", () => pm.expect(Math.abs(50 + body.fuel_plan.total_gallons_purchased - body.fuel_plan.total_gallons_consumed - body.fuel_plan.final_fuel_gallons)).to.be.below(0.005));",
              "  pm.collectionVariables.set(\"mapPath\", body.map_url);",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
